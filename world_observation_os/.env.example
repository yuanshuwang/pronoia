# MySQL (Docker Compose)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=world_observation
MYSQL_USER=woos
MYSQL_PASSWORD=woospass
MYSQL_ROOT_PASSWORD=rootpass

# SQLAlchemy connection URL (override if needed)
DATABASE_URL=mysql+pymysql://woos:woospass@127.0.0.1:3306/world_observation?charset=utf8mb4

# Reddit API (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=world_observation_os/1.0 by your_reddit_username

# Logging
LOG_LEVEL=INFO
